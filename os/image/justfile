setup:
    sudo apt install -y partclone squashfs-tools
    echo "deb http://deb.debian.org/debian forky main" | sudo tee /etc/apt/sources.list.d/forky.list
    sudo apt update
    sudo apt install -y -t forky rauc rauc-service
    sudo rm /etc/apt/sources.list.d/forky.list
    sudo apt update
    npm ci --omit=dev

test:
    validator user-data.yaml
    validator autoboot.ini
